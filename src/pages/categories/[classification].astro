---
import NewspaperHeader from "../../components/NewspaperHeader.astro";
import NewspaperLayout from "../../components/NewspaperLayout.astro";
import { getClassificationNodes } from "../../lib/classification";
import { getCalendarStatus } from "../../lib/uapis";
import "../../styles/newspaper-page.css";

export async function getStaticPaths() {
  const nodes = getClassificationNodes();

  function collectCodes(nodeList: typeof nodes): string[] {
    const codes: string[] = [];
    for (const node of nodeList) {
      codes.push(node.code);
      codes.push(...collectCodes(node.children));
    }
    return codes;
  }

  return collectCodes(nodes).map((code) => ({
    params: { classification: code },
  }));
}

const calendar = await getCalendarStatus();
---

<NewspaperLayout title="索引" description="文火电子书馆书目索引">
  <main class="newspaper-page" data-pagefind-ignore="all">
    <div class="newspaper-page-frame" aria-label="文火索引">
      <NewspaperHeader
        currentLabel="索引"
        dateLabel={calendar.dateLabel}
        weekdayLabel={calendar.weekdayLabel}
      />
      <section class="newspaper-reserved-content" aria-label="索引页待设计"></section>
    </div>
  </main>
</NewspaperLayout>
